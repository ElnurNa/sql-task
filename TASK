--TASK 1
SELECT JOB_TITLE, MAX_SALARY FROM HR.JOBS
WHERE MAX_SALARY>(SELECT AVG(MAX_SALARY) FROM HR.JOBS)
ORDER BY MAX_SALARY DESC;
--TASK 2
SELECT FIRST_NAME, LAST_NAME 
FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID IN (
    SELECT DEPARTMENT_ID 
    FROM HR.EMPLOYEES 
    WHERE FIRST_NAME = 'Steven' AND LAST_NAME = 'King'
)
AND NOT (FIRST_NAME = 'Steven' AND LAST_NAME = 'King');
--TASK 3
SELECT FIRST_NAME, LAST_NAME, JOB_ID FROM HR.EMPLOYEES
WHERE JOB_ID IN (SELECT JOB_ID FROM HR.EMPLOYEES
                GROUP BY JOB_ID
                HAVING COUNT(*)=1);
--TASK 4
SELECT DEPARTMENT_ID, COUNT(*) AS ISCI_SAYI
FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID IS NOT NULL
GROUP BY DEPARTMENT_ID
HAVING COUNT(*) > (
    SELECT COUNT(*)
    FROM HR.EMPLOYEES e
    JOIN HR.DEPARTMENTS d ON e.DEPARTMENT_ID = d.DEPARTMENT_ID
    WHERE d.DEPARTMENT_NAME = 'IT'
)
ORDER BY ISCI_SAYI DESC;
--TASK 5
SELECT FIRST_NAME, LAST_NAME, DEPARTMENT_ID
FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID IN (
    SELECT DEPARTMENT_ID
    FROM HR.DEPARTMENTS
    WHERE LOCATION_ID IN (
        SELECT LOCATION_ID
        FROM HR.LOCATIONS
        WHERE COUNTRY_ID = (
            SELECT COUNTRY_ID
            FROM HR.COUNTRIES
            WHERE COUNTRY_NAME = 'United Kingdom of Great Britain and Northern Ireland'
        )
    )
);
--TASK 6
SELECT JOB_TITLE, MIN_SALARY, MAX_SALARY
FROM HR.JOBS
WHERE JOB_ID = (
    SELECT JOB_ID
    FROM HR.EMPLOYEES
    GROUP BY JOB_ID
    ORDER BY COUNT(*) DESC
    FETCH FIRST 1 ROWS ONLY
);
--TASK 7
SELECT FIRST_NAME, LAST_NAME, DEPARTMENT_ID, SALARY
FROM HR.EMPLOYEES
WHERE DEPARTMENT_ID IN(
    SELECT DEPARTMENT_ID
    FROM HR.DEPARTMENTS
    WHERE DEPARTMENT_NAME IN ('Finance', 'Accounting')
)
ORDER BY SALARY DESC
FETCH FIRST 1 ROWS ONLY;
